{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main"],
  "extends": ["config:best-practices", ":semanticCommitTypeAll(chore)"],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "schedule": ["before 8am on monday"],
  "timezone": "America/Costa_Rica",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 5,
  "rebaseWhen": "conflicted",
  "prCreation": "immediate",
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "One weekly PR for all non-major sbt/Maven updates (each PR costs a full CI run). Ecosystem groups below override this for their packages; majors stay separate and need dashboard approval.",
      "groupName": "all non-major dependencies",
      "matchManagers": ["sbt", "maven"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "One weekly PR for all GitHub Actions pin/digest/minor/patch updates",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"]
    },
    {
      "description": "One weekly PR for Dockerfile base-image patch/digest/pin updates",
      "groupName": "Docker base images",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "digest", "pin", "pinDigest"]
    },
    {
      "description": "Group Akka ecosystem",
      "groupName": "Akka",
      "matchPackageNames": ["com.typesafe.akka:*"]
    },
    {
      "description": "Group Cats ecosystem",
      "groupName": "Cats",
      "matchPackageNames": ["org.typelevel:cats-*"]
    },
    {
      "description": "Group ScalaPB + protoc",
      "groupName": "ScalaPB",
      "matchPackageNames": ["com.thesamet.scalapb:*", "com.thesamet:sbt-protoc"]
    },
    {
      "description": "Group testing libs",
      "groupName": "Testing",
      "matchPackageNames": ["org.scalatest:*", "org.scalacheck:*", "org.scalamock:*"]
    },
    {
      "description": "Pin GitHub Actions to full SHA — Renovate keeps them current",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Pin Dockerfile base images to SHA256 digests — Renovate keeps them current",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge GitHub Actions minor/patch/digest updates — CI gates the merge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "automerge": false,
      "dependencyDashboardApproval": true,
      "description": "Require dashboard approval for Dockerfile major/minor base-image updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major", "minor"]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge Dockerfile patch/digest updates (low risk)",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "digest"]
    },
    {
      "automerge": false,
      "dependencyDashboardApproval": true,
      "description": "Require approval for all sbt major updates — may require source changes",
      "matchManagers": ["sbt"],
      "matchUpdateTypes": ["major"]
    },
    {
      "automerge": false,
      "dependencyDashboardApproval": true,
      "description": "Require approval for all major updates across all managers",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Not resolvable by the sbt/github-tags datasources (Scala-2-only stub, sbt-1 plugin path, renamed action repo); updated by hand",
      "matchPackageNames": ["org.scala-js:scalajs-stubs", "org.xerial.sbt:sbt-sonatype", "ScalableCapital/action-surefire-report"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": true,
    "description": "Security vulnerability fixes — automerge immediately after CI passes",
    "enabled": true,
    "labels": ["security", "dependencies"],
    "prCreation": "immediate"
  }
}
